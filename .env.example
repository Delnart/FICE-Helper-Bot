NODE_ENV=development

# HTTP
BACKEND_PORT=3000
FRONTEND_PORT=3001
PUBLIC_MINI_APP_URL=https://your-mini-app-domain.example
NEXT_PUBLIC_API_BASE=https://your-api-domain.example/api
CORS_ORIGIN=https://your-mini-app-domain.example
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=120

# MongoDB
MONGO_URI=mongodb://root:change_me_strong@mongo:27017/fice?authSource=admin
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=change_me_strong

# Auth
# Must be >= 32 chars. Generate: openssl rand -base64 48
JWT_SECRET=change_me_to_a_long_random_secret_at_least_32_chars
JWT_EXPIRES_IN=7d

# Telegram
# Create via @BotFather; enable Mini App and set menu button URL to PUBLIC_MINI_APP_URL
TELEGRAM_BOT_TOKEN=0000000000:REPLACE_ME
TELEGRAM_BOT_USERNAME=fice_helper_bot

# Campus KPI (https://api.campus.kpi.ua)
CAMPUS_API_BASE=https://api.campus.kpi.ua
CAMPUS_API_TOKEN=

# Google Sheets — service account with Viewer access to the sheet
# Sheet must contain tabs: "Старости" (Group | TG tag | Full name)
#                         "Викладачі" (Full name | Phone | TG | Email)
GOOGLE_SHEETS_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Paste the private_key from the JSON key verbatim (with \n newlines)
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
