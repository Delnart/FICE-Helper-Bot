{
  "name": "fice-helper-bot",
  "version": "0.1.0",
  "private": true,
  "description": "Telegram Mini App + Bot for academic groups (KPI FICE). Nest + Next + MongoDB.",
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm-run-all -p dev:backend dev:frontend",
    "dev:backend": "npm --workspace @fice/backend run start:dev",
    "dev:frontend": "npm --workspace @fice/frontend run dev",
    "build": "npm --workspace @fice/shared run build && npm --workspace @fice/backend run build && npm --workspace @fice/frontend run build",
    "lint": "npm --workspace @fice/backend run lint && npm --workspace @fice/frontend run lint",
    "test": "npm --workspace @fice/backend run test",
    "docker:up": "docker compose --env-file .env -f docker/docker-compose.yml up -d --build",
    "docker:down": "docker compose --env-file .env -f docker/docker-compose.yml down",
    "docker:logs": "docker compose --env-file .env -f docker/docker-compose.yml logs -f"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5",
    "prettier": "^3.2.5",
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}
